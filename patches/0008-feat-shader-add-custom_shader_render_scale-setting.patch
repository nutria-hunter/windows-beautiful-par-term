From b323bc0b4d9339128f4966e1d6808c46d69d7ac9 Mon Sep 17 00:00:00 2001
From: jky72 <jky72@users.noreply.github.com>
Date: Tue, 15 Sep 2026 23:41:51 +0900
Subject: [PATCH 8/8] feat(shader): add custom_shader_render_scale setting

Groundwork for rendering the background at a fraction of the window resolution and
upscaling it: 1.0 keeps the existing full-resolution path, 0.5 and 0.25 divide the
fragment work by 4 and 16, which is what a 4K background on integrated graphics
needs. Defaults to 1.0, so behaviour is unchanged until the render path lands.
Implementation plan: galaxy-work/work/PLAN-render-scale.md.
---
 .../src/config/config_struct/global_shader_config.rs      | 8 ++++++++
 par-term-config/src/defaults/misc.rs                      | 5 +++++
 par-term-config/src/defaults/mod.rs                       | 1 +
 3 files changed, 14 insertions(+)

diff --git a/par-term-config/src/config/config_struct/global_shader_config.rs b/par-term-config/src/config/config_struct/global_shader_config.rs
index c2b04b3..07e4ccb 100644
--- a/par-term-config/src/config/config_struct/global_shader_config.rs
+++ b/par-term-config/src/config/config_struct/global_shader_config.rs
@@ -42,6 +42,13 @@ pub struct GlobalShaderConfig {
     /// This dims the shader background to improve text readability
     pub custom_shader_brightness: f32,
 
+    /// Fraction of the window resolution the background shader is rendered at, upscaled with a
+    /// nearest-neighbour blit. 1.0 keeps the existing full-resolution path; 0.5 or 0.25 divide the
+    /// fragment work by 4 or 16, which is what makes a 4K background affordable on integrated
+    /// graphics. Values are clamped to 0.25..=1.0 when used.
+    #[serde(default = "crate::defaults::shader_render_scale")]
+    pub custom_shader_render_scale: f32,
+
     /// Texture file path for custom shader iChannel0 (optional, Shadertoy compatible)
     /// Supports ~ for home directory. Example: "~/textures/noise.png"
     pub custom_shader_channel0: Option<String>,
@@ -134,6 +141,7 @@ impl Default for GlobalShaderConfig {
         Self {
             custom_shader: None,
             custom_shader_enabled: crate::defaults::bool_true(),
+            custom_shader_render_scale: crate::defaults::shader_render_scale(),
             custom_shader_animation: crate::defaults::bool_true(),
             custom_shader_animation_speed: crate::defaults::custom_shader_speed(),
             custom_shader_text_opacity: crate::defaults::text_opacity(),
diff --git a/par-term-config/src/defaults/misc.rs b/par-term-config/src/defaults/misc.rs
index f6720e6..60ce0d1 100644
--- a/par-term-config/src/defaults/misc.rs
+++ b/par-term-config/src/defaults/misc.rs
@@ -8,6 +8,11 @@ pub fn bool_false() -> bool {
 }
 
 /// Serde default returning `true`.
+/// Background shader render scale: 1.0 = full resolution (the pre-existing behaviour).
+pub fn shader_render_scale() -> f32 {
+    1.0
+}
+
 pub fn bool_true() -> bool {
     true
 }
diff --git a/par-term-config/src/defaults/mod.rs b/par-term-config/src/defaults/mod.rs
index 86387e7..0474a27 100644
--- a/par-term-config/src/defaults/mod.rs
+++ b/par-term-config/src/defaults/mod.rs
@@ -65,6 +65,7 @@ pub use colors::{
 
 // ── Miscellaneous ──────────────────────────────────────────────────────────
 pub use misc::{
+    shader_render_scale,
     ambiguous_width, badge_color_alpha, badge_format, badge_max_height, badge_max_width,
     badge_right_margin, badge_top_margin, bool_false, bool_true, command_separator_opacity,
     command_separator_thickness, cursor_boost, cursor_shadow_blur, cursor_shadow_offset,
