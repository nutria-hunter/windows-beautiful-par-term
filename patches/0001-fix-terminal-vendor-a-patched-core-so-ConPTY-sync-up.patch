+/// Bitmap format for cached glyphs
+#[derive(Clone, Debug)]
+pub enum BitmapFormat {
+    /// Grayscale bitmap (8-bit alpha)
+    Grayscale,
+    /// RGBA bitmap (32-bit color with alpha)
