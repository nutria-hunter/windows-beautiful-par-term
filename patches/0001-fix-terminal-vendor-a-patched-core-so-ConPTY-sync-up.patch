+        use crate::python_bindings::observer::PyQueueObserver;
+        let asyncio = py.import("asyncio")?;
+        let queue = asyncio.call_method0("Queue")?;
+        let queue_obj: Py<pyo3::types::PyAny> = queue.unbind();
