+        let scrollback_len = self.grid.scrollback_len();
+        let mut lines = Vec::with_capacity(scrollback_len);
+        for i in 0..scrollback_len {
+            if let Some(line) = self.grid.scrollback_line(i) {
+                lines.push(cells_to_text(line));
