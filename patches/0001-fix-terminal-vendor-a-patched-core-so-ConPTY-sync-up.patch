+        // Black on white already has maximum contrast
+        let adjusted = py_adjust_contrast_rgb((0, 0, 0), (255, 255, 255), 0.5);
+        assert_eq!(adjusted, (0, 0, 0), "Good contrast should not be changed");
+    }
