+    #[test]
+    fn test_adjust_contrast_zero_minimum() {
+        // Zero minimum contrast should not change anything
+        let adjusted = py_adjust_contrast_rgb((64, 64, 64), (0, 0, 0), 0.0);
+        assert_eq!(adjusted, (64, 64, 64));
+    }
