+}
+
+/// Font wrapper that holds swash font data
+struct SwashFont {
+    data: Arc<Vec<u8>>, // Keep data alive for FontRef
+}
+
+impl SwashFont {
+    fn new(data: Vec<u8>) -> ScreenshotResult<Self> {
+        let data = Arc::new(data);
