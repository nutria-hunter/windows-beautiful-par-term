+            // Standard colors (0-7)
+            Color::Rgb(0x14, 0x19, 0x1E), // 0: Black
+            Color::Rgb(0xB4, 0x3C, 0x2A), // 1: Red
+            Color::Rgb(0x00, 0x81, 0x5B), // 2: Green
