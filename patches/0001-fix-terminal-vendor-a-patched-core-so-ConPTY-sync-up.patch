+    /// Get the server address
+    #[getter]
+    fn addr(&self) -> String {
+        self.addr.clone()
+    }
+
+    fn __repr__(&self) -> String {
+        format!(
+            "StreamingServer(addr='{}', clients={})",
+            self.addr,
+            if self.server.is_some() {
+                "active"
+            } else {
+                "stopped"
+            }
+        )
+    }
+}
