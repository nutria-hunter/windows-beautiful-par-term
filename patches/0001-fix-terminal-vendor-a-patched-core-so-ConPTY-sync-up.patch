+const CLIPBOARD_TRUNCATION_SUFFIX: &str = " [truncated]";
+/// Hard upper limit for clipboard content (10 MB), regardless of configured max_bytes
+const MAX_CLIPBOARD_CONTENT_SIZE: usize = 10_485_760;
