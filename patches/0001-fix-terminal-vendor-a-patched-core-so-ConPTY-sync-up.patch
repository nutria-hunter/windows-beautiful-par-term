+    /// Returns:
+    ///     List of all detected semantic items
+    fn detect_semantic_items(
+        &self,
+    ) -> PyResult<Vec<crate::python_bindings::types::PyDetectedItem>> {
+        use crate::terminal::DetectedItem;
+        let items = self.inner.detect_semantic_items();
+        Ok(items
+            .iter()
+            .map(|item| match item {
