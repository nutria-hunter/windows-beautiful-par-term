+            items
+                .into_iter()
+                .filter_map(|k| Self::parse_event_kind(&k))
+                .collect()
+        });
+        let queue_clone = queue_obj.clone_ref(py);
+        let observer = std::sync::Arc::new(PyQueueObserver::new(queue_clone, subs));
