+                image.put_pixel(x, y, Rgba([x as u8 * 64, y as u8 * 64, 128, 255]));
+            }
+        }
+
+        let encoded = encode(&image).unwrap();
+        let decoded = image::load_from_memory(&encoded).unwrap();
+        assert_eq!(decoded.width(), 4);
+        assert_eq!(decoded.height(), 4);
+    }
+}
