+        assert!(json.contains(r#""type":"input"#));
+        assert!(json.contains(r#""data":"ls\n"#));
+
+        // Deserialize back
+        let deserialized: ClientMessage = serde_json::from_str(&json).unwrap();
+        match deserialized {
+            ClientMessage::Input { data } => {
+                assert_eq!(data, "ls\n");
+            }
+            _ => panic!("Wrong message type"),
+        }
