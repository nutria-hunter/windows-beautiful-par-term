+
+    /// Calculate color distance
+    pub fn color_distance(&self, r1: u8, g1: u8, b1: u8, r2: u8, g2: u8, b2: u8) -> f32 {
+        let dr = r1 as f32 - r2 as f32;
+        let dg = g1 as f32 - g2 as f32;
+        let db = b1 as f32 - b2 as f32;
+        (dr * dr + dg * dg + db * db).sqrt()
+    }
