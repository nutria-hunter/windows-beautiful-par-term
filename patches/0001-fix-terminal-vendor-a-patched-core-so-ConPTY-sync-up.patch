+    #[test]
+    fn test_parse_begin() {
+        let mut parser = TmuxControlParser::new(true);
+        let notifications = parser.parse(b"%begin 1234567890 42 some-flag\n");
+        assert_eq!(notifications.len(), 1);
+
+        match &notifications[0] {
+            TmuxNotification::Begin {
+                timestamp,
+                command_number,
+                flags,
