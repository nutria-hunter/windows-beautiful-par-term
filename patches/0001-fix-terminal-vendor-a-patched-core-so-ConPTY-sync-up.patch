+        registry.add("warn".into(), "WARN".into(), vec![]).unwrap();
+
+        let matches = registry.scan_line(0, "ERROR and WARN on same line", None);
+        assert_eq!(matches.len(), 2);
+    }
+
+    #[test]
+    fn test_trigger_fire_once_per_line() {
