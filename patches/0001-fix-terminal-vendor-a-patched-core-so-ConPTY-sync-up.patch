+// Terminal streaming protocol definitions
+// This is the single source of truth for the binary WebSocket protocol.
+
+syntax = "proto3";
+
+package terminal;
+
+// RGB color (0-255 per channel)
+message Color {
+  uint32 r = 1;
+  uint32 g = 2;
+  uint32 b = 3;
+}
+
+// Terminal theme with 16 ANSI colors
+message ThemeInfo {
+  string name = 1;
+  Color background = 2;
+  Color foreground = 3;
+  repeated Color normal = 4;   // 8 colors (indices 0-7)
+  repeated Color bright = 5;   // 8 colors (indices 8-15)
+}
+
+// Event types for subscription
+enum EventType {
+  EVENT_TYPE_UNSPECIFIED = 0;
+  EVENT_TYPE_OUTPUT = 1;
+  EVENT_TYPE_CURSOR = 2;
+  EVENT_TYPE_BELL = 3;
+  EVENT_TYPE_TITLE = 4;
+  EVENT_TYPE_RESIZE = 5;
+  EVENT_TYPE_CWD = 6;
+  EVENT_TYPE_TRIGGER = 7;
+  EVENT_TYPE_ACTION = 8;
+  EVENT_TYPE_MODE = 9;
