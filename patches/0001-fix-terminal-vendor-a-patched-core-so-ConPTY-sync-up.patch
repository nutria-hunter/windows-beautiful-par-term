+
+    #[test]
+    fn test_parse_color() {
+        assert!(matches!(
+            parse_color("#FF0000"),
+            Some(Color::Rgb(255, 0, 0))
+        ));
+        assert!(matches!(
+            parse_color("rgb(255, 0, 0)"),
+            Some(Color::Rgb(255, 0, 0))
+        ));
+        assert!(matches!(parse_color("red"), Some(Color::Named(_))));
+        assert!(parse_color("invalid").is_none());
+    }
+
+    #[test]
+    fn test_generate_clear_screen() {
