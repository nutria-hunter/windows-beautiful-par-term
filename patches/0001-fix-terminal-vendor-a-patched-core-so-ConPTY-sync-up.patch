+    /// Shutdown the server and disconnect all clients
+    ///
+    /// Args:
+    ///     reason: Reason for shutdown
+    fn shutdown(&mut self, reason: String) -> PyResult<()> {
+        if let Some(server) = self.server.take() {
+            server.shutdown(reason);
+            Ok(())
+        } else {
+            Ok(()) // Already stopped
+        }
+    }
