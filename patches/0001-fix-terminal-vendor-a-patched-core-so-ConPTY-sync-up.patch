+            crate::unicode_width_config::AmbiguousWidth::Wide => PyAmbiguousWidth::Wide,
+        }
+    }
+}
+
+impl From<PyAmbiguousWidth> for crate::unicode_width_config::AmbiguousWidth {
+    fn from(width: PyAmbiguousWidth) -> Self {
+        match width {
