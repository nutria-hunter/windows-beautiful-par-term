+            .graphics_store
+            .graphics_in_scrollback(start_row, end_row)
+    }
+
+    /// Get all scrollback graphics
+    pub fn all_scrollback_graphics(&self) -> &[TerminalGraphic] {
+        self.graphics.graphics_store.all_scrollback_graphics()
+    }
+
