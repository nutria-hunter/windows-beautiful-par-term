+#[pymethods]
+impl PyWidthConfig {
+    /// Create a new WidthConfig with specified settings
+    ///
+    /// Args:
+    ///     unicode_version: Unicode version for width tables (default: Auto)
+    ///     ambiguous_width: Treatment of ambiguous characters (default: Narrow)
+    #[new]
