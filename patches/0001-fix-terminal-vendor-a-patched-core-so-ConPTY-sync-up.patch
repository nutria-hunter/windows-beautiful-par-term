+    /// Background color (RGB)
+    pub background: (u8, u8, u8),
+    /// Foreground color (RGB)
+    pub foreground: (u8, u8, u8),
+    /// Normal ANSI colors 0-7 (RGB)
+    pub normal: [(u8, u8, u8); 8],
+    /// Bright ANSI colors 8-15 (RGB)
+    pub bright: [(u8, u8, u8); 8],
+}
