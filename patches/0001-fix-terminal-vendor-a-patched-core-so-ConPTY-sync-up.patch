+                    }
+                }
+                DetectedItem::FilePath(text, row, col, line_num) => {
+                    crate::python_bindings::types::PyDetectedItem {
+                        item_type: "filepath".to_string(),
+                        text: text.clone(),
+                        row: *row,
+                        col: *col,
