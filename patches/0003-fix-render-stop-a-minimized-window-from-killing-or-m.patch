+    use super::thumb_height;
+
+    #[test]
+    fn tiny_tracks_never_produce_a_negative_scroll_range() {
+        for track in [0.0_f32, 1.0, 19.0, 20.0, 21.0, 100.0] {
+            for ratio in [0.0_f32, 0.01, 0.5, 1.0] {
+                let height = thumb_height(ratio, track);
+                let travel = track - height;
+                assert!(height >= 0.0 && height <= track);
+                assert_eq!(travel.clamp(0.0, travel), travel);
+            }
+        }
+    }
