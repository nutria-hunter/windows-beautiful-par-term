+/// The minimum clickable size cannot exceed the available track (e.g. on minimize).
+fn thumb_height(viewport_ratio: f32, track_height: f32) -> f32 {
+    (viewport_ratio * track_height)
+        .max(MIN_SCROLLBAR_THUMB_HEIGHT_PX)
+        .min(track_height)
