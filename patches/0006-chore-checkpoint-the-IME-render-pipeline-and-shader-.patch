+#[test]
+fn split_transaction_head_is_not_applied_until_complete() {
+    let mut term = Terminal::new(120, 24);
+    // A read ending mid-transaction must not become visible on its own.
+    term.process(b"\x1b[?2026hTORN-HEAD-");
+    assert!(
